# Copy this file to .env and fill in your values. Never commit .env.

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma 4 model served through the Gemini API
# Options: gemma-4-26b-a4b-it (default, faster) or gemma-4-31b-it (larger)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Abuse guards (optional, defaults shown)
LIMIT_READS_PER_HOUR=10
LIMIT_ASKS_PER_HOUR=30
LIMIT_GLOBAL_PER_DAY=500
COOLDOWN_SECONDS=4
MAX_UPLOAD_MB=8
MAX_QUESTION_CHARS=300
